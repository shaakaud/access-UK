export EDITOR=vim

if [ -e ~/.aliases_bash ]
then
    source ~/.aliases_bash
fi
#######################################################################
#AUTOJUMP
#######################################################################
[[ -s ~/.autojump/etc/profile.d/autojump.sh ]] && source ~/.autojump/etc/profile.d/autojump.sh

####
#GIT related
###
#Show git Branch in the prompt
[ -f ~/.git-prompt.sh ] && source ~/.git-prompt.sh
export PS1="\w=>$ "
#export PS1="\h \w=>$ "
#export PS1="\$(__git_ps1)\w=>$ "
#GIT autocompletion
if [ -f /etc/bash_completion.d/git ]; then
    . /etc/bash_completion.d/git
fi

# History Size
HISTSIZE=1000

#Avoid screen feeze when Ctrl-S is pressed on VIM screen
stty -ixon 

# Remove all unnecassary files 
alias f='rm -f *~; rm -f *#'

# Keep personal user bin on PATH for interactive shells.
if [ -d "$HOME/bin" ] && [[ ":$PATH:" != *":$HOME/bin:"* ]]; then
    export PATH="$PATH:$HOME/bin"
fi

# Preserve legacy DISPLAY discovery behavior when DISPLAY is unset.
if [ -z "${DISPLAY:-}" ]; then
    XSERVER=$(who am i | /bin/awk '{print $6}' | /bin/sed 's/[()]//g')
    XSERVER=${XSERVER%%:*}
    if [[ -z "$XSERVER" || "$XSERVER" == "$(hostname)" || "$XSERVER" == "unix" ]]; then
        export DISPLAY="$(hostname):0.0"
    else
        export DISPLAY="$XSERVER:0.0"
    fi
fi

[ -f ~/.fzf.bash ] && source ~/.fzf.bash
