{
  "model": "claude-sonnet-4-6",
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Bash(docker info *)",
      "Bash(kubectl *)"      
    ],
    "ask": [
      "Bash(git commit*)"
    ],    
    "deny": [
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git force*)"      
    ]    
  }  
}
