function exists { which $1 &> /dev/null }

export PATH="/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:/usr/X11R6/bin:/usr/bin/vim:$HOME/bin:$HOME/gcp-ws/scripts"
export TMPDIR="/tmp"
export POWERLEVEL9K_WHITESPACE_BETWEEN_LEFT_SEGMENTS=""
typeset -g POWERLEVEL9K_SHORTEN_DIR_LENGTH=2
typeset -g POWERLEVEL9K_SHORTEN_STRATEGY=truncate_to_unique
typeset -g POWERLEVEL9K_LEFT_PROMPT_ELEMENTS=(dir vcs)
typeset -g POWERLEVEL9K_PROMPT_ON_NEWLINE=false

# Disable right-side prompt segments (time/status/etc.) for powerlevel9k.
typeset -g POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=()

# Migrated from bash/bashrc_for_zsh
if [[ -z "$USER" && -n "$USERNAME" ]]; then
    export USER="$USERNAME"
fi
if [[ -z "$USERNAME" && -n "$USER" ]]; then
    export USERNAME="$USER"
fi

if [[ -d "$HOME/bin" && ":$PATH:" != *":$HOME/bin:"* ]]; then
    export PATH="$PATH:$HOME/bin"
fi

if [[ -n "$TMP" && ! -d "$TMP" ]]; then
    mkdir -p "$TMP"
fi

# HISTSIZE settings moved to end of file for consistency

setopt ignore_eof
setopt noclobber
setopt cdablevars

alias copy='cp -i'
alias del='rm -i'
alias dir='ls -lF'
alias h=history
alias la='ls -a'
alias ll='ls -l'
alias ls='ls -F'
alias more=less
alias mv='mv -i'
alias ren='mv -i'
alias rm='rm -i'

# Preserve legacy workspace aliases for zsh users when available.
# Source this after the default aliases above so old workspace shortcuts and
# alias overrides keep working under zsh.
if [[ -f ~/.aliases_bash ]]; then
    source ~/.aliases_bash
fi

if [[ -z "${DISPLAY:-}" ]]; then
    XSERVER=$(who am i | /usr/bin/awk '{print $6}' | /bin/sed 's/[()]//g')
    XSERVER=${XSERVER%%:*}
    if [[ -z "$XSERVER" || "$XSERVER" == "$(hostname)" || "$XSERVER" == "unix" ]]; then
        export DISPLAY="$(hostname):0.0"
    else
        export DISPLAY="$XSERVER:0.0"
    fi
fi

# ============================================================================
# PERSONAL CONFIGURATIONS (Migrated from bash/bashrc.local_for_zsh)
# ============================================================================

# Personal configurations
export LOC=0.0MG
export USERINITIALS=mv
export EMAIL_ADDR=udaytj@versa-networks.com
export EDITOR=vim

# .bashrc overrides
export CVSROOT=":pserver:$CVSUSERNAME@cvspc.mv.usa.alcatel.com:/swdev/cvsrep"
export EMACS_BASE=/usr/local/emacs
export TEMP=/temp
export TGT_PF=7750

# VI-clone path setup
if ! uname -a | grep -qi cygwin; then
    if [[ -f /usr/local/bin/vim ]]; then
        PATH=$PATH:/usr/local/bin/vim
    elif [[ -f /usr/bin/vim ]]; then
        PATH=$PATH:/usr/bin/vim
    fi
fi

# CSCOPE_EDITOR setup (Linux only)
if ! uname -a | grep -qi cygwin; then
    if [[ -f /usr/local/bin/vim ]]; then
        export CSCOPE_EDITOR=/usr/local/bin/vim
    elif [[ -f /usr/bin/vim ]]; then
        export CSCOPE_EDITOR=/usr/bin/vim
    fi
    alias ctags='/usr/bin/ctags'
fi

# To make Ctrl-Right-Arrow, Ctrl-Left-Arrow work in Terminal for cscope searches
export TERM=xterm-256color

# ============================================================================
# GIT RELATED
# ============================================================================
[ -f ~/.git-prompt.sh ] && source ~/.git-prompt.sh

# HISTSIZE is set later in the configuration

# PROMPT and context variables
COMMENT=
export PAN_DIR=$(pwd)
export PANOS=$(pwd)

# PATH updates
PATH=$PATH:~/access-UK/bin/git:/sbin

# Avoid screen freeze when Ctrl-S is pressed on VIM screen
stty -ixon

# ============================================================================
# GENERAL UTILITIES
# ============================================================================

# Remove all unnecessary files
alias f='rm -f *~; rm -f *#'

# Modified Files
alias m='cvs -n up -P -d 2>/dev/null | grep -v "^[/?U]" 2>/dev/null'

# ============================================================================
# FZF-TMUX FILE SEARCH FUNCTIONS (Docs-UK integration)
# ============================================================================

cmdsh2ndpart() {
    local RFILE=~/tmuxbuffer/resultcmdsh
    local DIR_PREFIX=$(dirname $RFILE)
    
    if [[ ! -f $RFILE ]]; then
        /usr/bin/inotifywait $DIR_PREFIX -e create -e moved_to | while read path action file; do :; done
    fi
    
    if [[ ! -s $RFILE ]]; then
        echo " " > $RFILE
    fi
    
    sed -i 's/;#.*$//g' $RFILE
    perl -pi -e 'chomp if eof' $RFILE
}

cmdsh() {
    local RFILE=~/tmuxbuffer/resultcmdsh
    local DIR_PREFIX=$(dirname $RFILE)
    local TXTFILES=~/Docs-UK/txtfiles.txt
    
    rm -f ~/tmuxbuffer/resultcmdsh
    cat $(grep -v '^#' $TXTFILES) | fzf-tmux -p 80%,60% --exact --reverse --no-sort -m > $RFILE
}


if exists percol; then
    function percol_select_history() {
        local tac
        exists gtac && tac="gtac" || { exists tac && tac="tac" || { tac="tail -r" } }
        BUFFER=$(fc -l -n 1 | eval $tac | percol --query "$LBUFFER")
        CURSOR=$#BUFFER         # move cursor
        zle -R -c               # refresh
    }

    zle -N percol_select_history
    bindkey '^R' percol_select_history
fi

setopt extendedglob
export DISABLE_AUTO_TITLE=true

__git_files () {
      _wanted files expl 'local files' _files
}

# Fix Home/End keys in tmux or terminals sending weird codes
bindkey '\e[H' beginning-of-line
bindkey '\e[F' end-of-line
bindkey '\eOH' beginning-of-line
bindkey '\eOF' end-of-line

#autojump
[[ -s ~/.autojump/etc/profile.d/autojump.sh ]] && source ~/.autojump/etc/profile.d/autojump.sh
autoload -U compinit && compinit -u

#Up arrow should not display global history. ctrl-p to display global history

bindkey '^[[A' up-line-or-local-history
bindkey '^[[B' down-line-or-local-history
bindkey '^[[1;5A' up-line-or-local-history
bindkey '^[[1;5B' down-line-or-local-history

up-line-or-local-history() {
   zle set-local-history 1
   zle up-line-or-history
   zle set-local-history 0
}
zle -N up-line-or-local-history
down-line-or-local-history() {
   zle set-local-history 1
   zle down-line-or-history
   zle set-local-history 0
}
zle -N down-line-or-local-history

# UDAY - show git status in prompt when plugin repo is available.
[[ -f ~/access-UK/zsh/zsh-git-prompt/zshrc.sh ]] && \
    source ~/access-UK/zsh/zsh-git-prompt/zshrc.sh

